# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Clash Royale API
CLASH_ROYALE_API_KEY=your_clash_royale_api_key

# Public site URL for SEO and share links
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Model tools: enable after the Railway service and Supabase migrations are ready
MODEL_TOOLS_ENABLED=1
NEXT_PUBLIC_MODEL_TOOLS_ENABLED=1
MODEL_SERVICE_URL=https://your-railway-service.example
MODEL_SERVICE_TOKEN=generate_a_long_random_shared_token
CRON_SECRET=generate_a_separate_long_random_token

# Enable after the history migrations are present in Supabase. Both manual sync
# and the existing nightly cron then capture owner and tracked-friend matches.
MATCH_HISTORY_ENABLED=1

